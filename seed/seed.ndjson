{"_id": "homepage", "_type": "homepage", "heroHeading": "From put-in to take-out: a lifeline and icon of the northwoods. Forged in the USA from 5160 carbon steel.", "heroCtaLabel": "Shop", "newReleases": [{"_type": "reference", "_ref": "product.sailor-s-knife", "_key": "k1"}, {"_type": "reference", "_ref": "product.solid-brass-dice", "_key": "k2"}, {"_type": "reference", "_ref": "product.the-optimist", "_key": "k3"}, {"_type": "reference", "_ref": "product.ten-inch-paper-scissors", "_key": "k4"}], "features": [{"_key": "f1", "eyebrow": "Made in USA", "heading": "The 41D Is Back", "body": "When we first introduced the 41D in November 2014, we didn't change much—we didn't need to—kiln-dried American cherry, plain sawn and finished with brass hardware.", "ctaLabel": "Discover More"}, {"_key": "f2", "eyebrow": "Origin Story", "body": "We champion American makers because it gives us an unprecedented connection to the development and manufacturing of our products, and it's an investment in the people and communities close to home.", "ctaLabel": "Shop Made in the USA"}, {"_key": "f3", "eyebrow": "Est. 2009 / Re-Est. 2024", "heading": "Quality Will Prevail", "body": "Making, buying, using, and owning quality products should uplift everyone at every stage of a product's life. In the disposable age of planned obsolescence, prioritizing quality is a responsible and optimistic path forward.", "ctaLabel": "Learn More About Us"}]}
